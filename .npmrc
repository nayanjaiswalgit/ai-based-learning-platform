# pnpm configuration
# See: https://pnpm.io/npmrc

# Use hoisting for better Windows compatibility
# This may be needed if you encounter module resolution issues
shamefully-hoist=true
public-hoist-pattern[]=*

# Strict peer dependencies (recommended for monorepos)
strict-peer-dependencies=false

# Auto-install peers
auto-install-peers=true

# Store directory (optional - uncomment to customize)
# store-dir=~/.pnpm-store

# Lockfile settings
lockfile=true

# Registry (use default npm registry)
registry=https://registry.npmjs.org/

# Optional dependencies (allow build failures for node-pty on Windows)
optional-deps-behavior=install

# Server
PORT=4001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ai_learning_platform"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS S3 / Cloudflare R2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=ai-learning-platform

# Cloudflare R2 (Alternative to S3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ai-learning-platform
R2_PUBLIC_URL=https://your-r2-bucket.r2.dev

# Mux (Video Streaming & Transcoding)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE_KEY=

# OpenAI (for SEO descriptions)
OPENAI_API_KEY=

# CDN
CDN_URL=https://cdn.yourplatform.com

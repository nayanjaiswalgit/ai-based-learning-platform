# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/learning_platform?schema=public"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Database Read Replicas
DATABASE_READ_REPLICA_1="postgresql://postgres:password@localhost:5433/learning_platform?schema=public"
DATABASE_READ_REPLICA_2="postgresql://postgres:password@localhost:5434/learning_platform?schema=public"
DATABASE_READ_REPLICA_3="postgresql://postgres:password@localhost:5435/learning_platform?schema=public"
DATABASE_READ_REPLICA_4="postgresql://postgres:password@localhost:5436/learning_platform?schema=public"
DATABASE_READ_REPLICA_5="postgresql://postgres:password@localhost:5437/learning_platform?schema=public"

# PgBouncer
PGBOUNCER_URL="postgresql://postgres:password@localhost:6432/learning_platform"

# Redis Cluster
REDIS_CLUSTER_NODES="localhost:7001,localhost:7002,localhost:7003,localhost:7004,localhost:7005,localhost:7006"
REDIS_PASSWORD=""

# Redis Single Instance
REDIS_URL="redis://localhost:6379"

# Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_MASTER_KEY="masterKey"

# Pinecone
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_ENVIRONMENT="us-east-1-aws"
PINECONE_INDEX_NAME="learning-platform"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_CALLBACK_URL="http://localhost:3000/api/auth/github/callback"

LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
LINKEDIN_CALLBACK_URL="http://localhost:3000/api/auth/linkedin/callback"

# AWS S3
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="learning-platform-videos"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# OpenAI
OPENAI_API_KEY="sk-..."

# Anthropic Claude
ANTHROPIC_API_KEY="sk-ant-..."

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@yourplatform.com"

# Email (Resend)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Sentry
SENTRY_DSN="https://..."
SENTRY_AUTH_TOKEN="..."

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# SAML (Enterprise SSO)
SAML_ENTRY_POINT="https://your-idp.com/saml/sso"
SAML_ISSUER="your-app-issuer"
SAML_CERT="your-saml-certificate"

# CAPTCHA
RECAPTCHA_SITE_KEY="your-recaptcha-site-key"
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"

# 2FA
TWO_FA_APP_NAME="AI Learning Platform"

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=10

# Node Environment
NODE_ENV="development"
PORT=3000

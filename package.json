{
  "name": "ai-based-learning-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:seed": "cd packages/database && pnpm db:seed",
    "db:studio": "cd packages/database && pnpm db:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "@types/node": "^22.9.1",
    "eslint": "^9.15.0"
  },
  "packageManager": "pnpm@9.14.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}

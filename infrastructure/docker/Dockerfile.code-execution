# Multi-stage build for code execution service
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml ./
COPY services/code-execution-service/package.json ./services/code-execution-service/

# Install dependencies
RUN npm install -g pnpm@9.14.4
RUN pnpm install --frozen-lockfile

# Copy source
COPY services/code-execution-service ./services/code-execution-service
COPY packages ./packages

# Build
WORKDIR /app/services/code-execution-service
RUN pnpm build

# Production image
FROM node:20-alpine

WORKDIR /app

# Install Docker CLI for container management
RUN apk add --no-cache docker-cli

# Copy built application
COPY --from=builder /app/services/code-execution-service/dist ./dist
COPY --from=builder /app/services/code-execution-service/node_modules ./node_modules
COPY --from=builder /app/services/code-execution-service/package.json ./

# Create non-root user
RUN addgroup -g 1001 -S nodejs
RUN adduser -S nestjs -u 1001

# But allow docker socket access (will be handled by k8s volume mount permissions)
USER root

EXPOSE 3002

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s \
  CMD node -e "require('http').get('http://localhost:3002/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

CMD ["node", "dist/main.js"]

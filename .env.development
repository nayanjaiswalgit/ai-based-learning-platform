# Development Environment Variables
# These are safe defaults for local development

NODE_ENV=development

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=learning_platform
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_PASSWORD=redis123
REDIS_HOST=localhost
REDIS_PORT=6379

# Application
PORT=4000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4003

# Security (Development only - CHANGE IN PRODUCTION)
JWT_SECRET=dev_jwt_secret_change_in_production
NEXTAUTH_SECRET=dev_nextauth_secret_change_in_production
SESSION_SECRET=dev_session_secret_change_in_production

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_CHATBOT=true
ENABLE_CODE_EXECUTION=true
ENABLE_VIDEO_DRM=false

# Server Configuration
PORT=3003
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ai_learning_platform?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CUSTOMER_PORTAL_URL=https://billing.stripe.com/p/login/test_xxx

# Stripe Products
STRIPE_PRODUCT_PRO_MONTHLY=price_xxx
STRIPE_PRODUCT_PRO_YEARLY=price_xxx
STRIPE_PRODUCT_ENTERPRISE=price_xxx

# Razorpay (India)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx

# PayPal
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
PAYPAL_MODE=sandbox

# Paddle
PADDLE_VENDOR_ID=xxx
PADDLE_VENDOR_AUTH_CODE=xxx
PADDLE_PUBLIC_KEY=xxx
PADDLE_ENVIRONMENT=sandbox

# Currency Conversion API
EXCHANGE_RATE_API_KEY=xxx

# Purchase Power Parity
PPP_ENABLED=true
PPP_DEFAULT_DISCOUNT=0.3
PPP_MIN_DISCOUNT=0.1
PPP_MAX_DISCOUNT=0.7

# Pricing Plans (USD)
PLAN_FREE_PRICE=0
PLAN_PRO_MONTHLY_PRICE=29
PLAN_PRO_YEARLY_PRICE=290
PLAN_ENTERPRISE_PRICE=999

# Trial Period
TRIAL_PERIOD_DAYS=7

# Revenue Share
INSTRUCTOR_REVENUE_SHARE=0.70
PLATFORM_REVENUE_SHARE=0.30

# Payment Processing
PAYMENT_QUEUE_NAME=payment-processing
PAYOUT_QUEUE_NAME=instructor-payouts

# Email Service
EMAIL_SERVICE_URL=http://notification-service:3005

# Logging
LOG_LEVEL=info

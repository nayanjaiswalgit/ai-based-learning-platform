# Terminal Service Environment Variables

# Server
PORT=3007
NODE_ENV=development

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Docker
DOCKER_SOCKET_PATH=/var/run/docker.sock

# CORS
CORS_ORIGIN=http://localhost:3000

# Session
SESSION_TTL=1800  # 30 minutes in seconds

# Logging
LOG_LEVEL=info

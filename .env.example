# AI Learning Platform - Environment Configuration
# Copy this file to .env: cp .env.example .env

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_learning_platform"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# JWT
JWT_SECRET="change-this-secret-in-production"
JWT_EXPIRES_IN="7d"

# AI Services (OPTIONAL for basic development)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Application
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
API_URL="http://localhost:4000"

# Feature Flags
ENABLE_AI_FEATURES=false
ENABLE_TERMINAL=false
ENABLE_CODE_EXECUTION=false

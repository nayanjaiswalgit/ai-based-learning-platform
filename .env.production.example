# Production Environment Variables Template
# IMPORTANT: Replace ALL values with production credentials

NODE_ENV=production

# Database (Production)
DATABASE_URL=postgresql://user:password@production-db:5432/learning_platform

# Redis (Production)
REDIS_URL=redis://:password@production-redis:6379

# JWT (MUST BE STRONG & UNIQUE)
JWT_SECRET=<generate_strong_secret_here>
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=<generate_strong_secret_here>
REFRESH_TOKEN_EXPIRES_IN=7d

# NextAuth
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=<generate_strong_secret_here>

# Application URLs
FRONTEND_URL=https://yourdomain.com
ADMIN_URL=https://admin.yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_WS_URL=wss://ws.yourdomain.com

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=https://your_actual_sentry_dsn@sentry.io/project_id
SENTRY_AUTH_TOKEN=your_actual_sentry_auth_token

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CHATBOT=true
ENABLE_CODE_EXECUTION=true
ENABLE_VIDEO_DRM=true
ENABLE_PPP_PRICING=true
ENABLE_WHITE_LABEL=true

# Security
CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
COOKIE_DOMAIN=yourdomain.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

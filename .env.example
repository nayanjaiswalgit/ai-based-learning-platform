# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/learning_platform?schema=public"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Database Read Replicas
DATABASE_READ_REPLICA_1="postgresql://postgres:password@localhost:5433/learning_platform?schema=public"
DATABASE_READ_REPLICA_2="postgresql://postgres:password@localhost:5434/learning_platform?schema=public"
DATABASE_READ_REPLICA_3="postgresql://postgres:password@localhost:5435/learning_platform?schema=public"
DATABASE_READ_REPLICA_4="postgresql://postgres:password@localhost:5436/learning_platform?schema=public"
DATABASE_READ_REPLICA_5="postgresql://postgres:password@localhost:5437/learning_platform?schema=public"

# PgBouncer
PGBOUNCER_URL="postgresql://postgres:password@localhost:6432/learning_platform"

# Redis Cluster
REDIS_CLUSTER_NODES="localhost:7001,localhost:7002,localhost:7003,localhost:7004,localhost:7005,localhost:7006"
REDIS_PASSWORD=""

# Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_MASTER_KEY="masterKey"

# Pinecone
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_ENVIRONMENT="us-east-1-aws"
PINECONE_INDEX_NAME="learning-platform"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# AWS S3
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="learning-platform-videos"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# OpenAI
OPENAI_API_KEY="sk-..."

# Anthropic Claude
ANTHROPIC_API_KEY="sk-ant-..."

# Email (Resend)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Sentry
SENTRY_DSN="https://..."
SENTRY_AUTH_TOKEN="..."

# Node Environment
NODE_ENV="development"
PORT=3000
